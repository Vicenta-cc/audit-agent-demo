[Unit]
Description=Coder ASR tunnel for isolated XHS Audit R2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/mnt/datadisk0/xhs-audit-agent-r2-abc/runtime/coder/coder.env
Environment=HOME=/mnt/datadisk0/xhs-audit-agent-r2-abc/runtime/coder/home
ExecStartPre=/usr/bin/test -x /mnt/datadisk0/xhs-audit-agent-r2-abc/runtime/bin/coder
ExecStart=/mnt/datadisk0/xhs-audit-agent-r2-abc/runtime/bin/coder port-forward hsw18500028764/guixu-workspace --tcp 127.0.0.1:19001:19001
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
