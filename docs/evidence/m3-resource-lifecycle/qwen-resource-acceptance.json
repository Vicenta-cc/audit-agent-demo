            "name": "维汉民族关系讨论审核规则",
            "domain": "民族关系",
            "audit_goal": "识别针对维吾尔族、汉族及其他民族群体的仇恨言论、歧视性攻击和暴力威胁，同时保护正常民族认同表达、文化保护讨论和个人婚恋选择",
            "general_exemptions": [
              {
                "exemption_id": "normal_identity_expression",
                "name": "正常民族身份与文化表达",
                "condition": "表达对自身或他民族文化的认同、保护、传承意愿，或讨论个人婚恋选择、跨民族交往等正常生活议题，不包含对任何民族的负面定性或攻击",
                "source_mappings": []
              },
              {
                "exemption_id": "critical_reference",
                "name": "新闻学术与批判性引用",
                "condition": "以新闻报道、学术研究或批判性讨论为目的，引用不支持风险表达的内容，且上下文明确表示不赞同该风险表达",
                "source_mappings": []
              }
            ],
            "categories": [
              {
                "category_id": "ethnic_hate_speech",
                "name": "民族仇恨与歧视",
                "description": "",
                "order": 1,
                "rules": [
                  {
                    "rule_id": "group_negative_generalization",
                    "name": "群体负面泛化与先天优劣主张",
                    "hit_condition": "对维吾尔族、汉族或其他民族群体进行整体负面定性（如'某族人都如何'），或主张某民族在先天、文化、道德上优于或劣于另一民族",
                    "suggested_risk_level": "medium",
                    "rule_exemptions": [],
                    "application_stages": [
                      "image_evidence",
                      "video_frame_evidence",
                      "comment_audit",
                      "fusion_audit"
                    ],
                    "adjudication_notes": "需区分对具体个人的行为批评与对整体民族的负面泛化。对具体行为（如售假、欺诈）的批评不能仅因账号民族背景而命中本规则",
                    "enabled": true,
                    "order": 1,
                    "source_mappings": []
                  },
                  {
                    "rule_id": "dehumanization_collective_stigma",
                    "name": "非人化与严重集体犯罪污名",
                    "hit_condition": "将民族群体比作动物、害虫、病毒等非人存在，或将整个民族定性为恐怖分子、罪犯、骗子等严重集体犯罪标签",
                    "suggested_risk_level": "high",
                    "rule_exemptions": [],
                    "application_stages": [
                      "image_evidence",
                      "video_frame_evidence",
                      "comment_audit",
                      "fusion_audit"
                    ],
                    "adjudication_notes": "非人化比喻和严重集体犯罪污名通常构成高风险。需确认是针对整体民族的定性，而非对具体犯罪个案的描述",
                    "enabled": true,
                    "order": 2,
                    "source_mappings": []
                  },
                  {
                    "rule_id": "rights_deprivation_expulsion",
                    "name": "权利剥夺、驱逐或血统纯洁主张",
                    "hit_condition": "主张某民族应被剥夺公民权利、被驱逐出某地，或以血统污染、血统纯洁为由反对民族通婚、要求强制阻止婚姻",
                    "suggested_risk_level": "high",
                    "rule_exemptions": [],
                    "application_stages": [
                      "image_evidence",
                      "video_frame_evidence",
                      "comment_audit",
                      "fusion_audit"
                    ],
                    "adjudication_notes": "血统纯洁主张无需同时要求强制阻止婚姻即可命中。需区分反对通婚的个人偏好表达与主张强制阻止的政策性要求",
                    "enabled": true,
                    "order": 3,
                    "source_mappings": []
                  },
                  {
                    "rule_id": "explicit_violence_threat",
                    "name": "明确暴力威胁",
                    "hit_condition": "对民族群体或个人发出明确暴力威胁、煽动伤害、屠杀或身体攻击",
                    "suggested_risk_level": "high",
                    "rule_exemptions": [],
                    "application_stages": [
                      "image_evidence",
                      "video_frame_evidence",
                      "comment_audit",
                      "fusion_audit"
                    ],
                    "adjudication_notes": "需确认是明确的暴力威胁或煽动，而非隐喻性表达或历史事件讨论",
                    "enabled": true,
                    "order": 4,
                    "source_mappings": []
                  },
                  {
                    "rule_id": "ethnic_relation_attack",
                    "name": "民族关系关联攻击",
                    "hit_condition": "对跨民族情侣、红娘、支持民族融合者的攻击、侮辱或诅咒，须与其民族相关身份、行为或立场有明显关联",
                    "suggested_risk_level": "medium",
                    "rule_exemptions": [],
                    "application_stages": [
                      "image_evidence",
                      "video_frame_evidence",
                      "comment_audit",
                      "fusion_audit"
                    ],
                    "adjudication_notes": "攻击须与民族相关身份、行为或立场有明显关联。普通售假等具体行为批评不能仅因账号民族背景而命中",
                    "enabled": true,
                    "order": 5,
                    "source_mappings": []
                  },
                  {
                    "rule_id": "uyghur_abuse_signal",
                    "name": "维语恶意辱骂专项线索",
                    "hit_condition": "可靠维语原文或译文中出现明确恶意辱骂词汇，不要求民族对象或民族动机，仅作低优先级敌意线索，不据此认定民族仇恨",
                    "suggested_risk_level": "low",
                    "rule_exemptions": [],
                    "application_stages": [
                      "comment_audit",
                      "fusion_audit"
                    ],
                    "adjudication_notes": "单纯使用维语不命中。本规则仅作低优先级敌意线索，需结合其他证据判断是否构成民族仇恨。有明确民族攻击规则可用时优先使用明确规则",
                    "enabled": true,
                    "order": 6,
                    "source_mappings": []
                  }
                ]
              }
            ]
