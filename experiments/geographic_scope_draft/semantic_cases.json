{
  "schema_version": "geographic-scope-semantic-cases-v1",
  "purpose": "按2026-10-15用户最终纠正更新：最细支持到城市，接受省级及地级市（含直辖市）。固定评测集未整体运行；少量真实前端对话另记，不计整集通过。P0冻结记录不改。",
  "target_policy": "single_province_or_prefecture_city_including_municipality",
  "cases": [
    {
      "id": "explicit_city",
      "messages": [
        "调查克拉玛依的招聘诈骗内容"
      ],
      "expected": {
        "action": "set",
        "target_text": "克拉玛依",
        "selection_policy": "local_first_with_supplement",
        "result": "resolved",
        "target_name": "克拉玛依市"
      }
    },
    {
      "id": "only_local",
      "messages": [
        "只要大庆当地的欠薪内容，不足也不要其他地区"
      ],
      "expected": {
        "action": "set",
        "target_text": "大庆",
        "selection_policy": "local_only"
      }
    },
    {
      "id": "province",
      "messages": [
        "查广东的相关内容"
      ],
      "expected": {
        "action": "set",
        "target_text": "广东",
        "selection_policy": "local_first_with_supplement",
        "result": "resolved",
        "target_name": "广东省"
      }
    },
    {
      "id": "municipality",
      "messages": [
        "本次内容范围改为北京"
      ],
      "expected": {
        "action": "set",
        "target_text": "北京",
        "selection_policy": "local_first_with_supplement"
      }
    },
    {
      "id": "account_background",
      "messages": [
        "这个账号在深圳，帮我查它是否发布违规招聘内容"
      ],
      "expected": {
        "action": "omit",
        "reason": "账号背景不等于本次内容地域限定"
      }
    },
    {
      "id": "resource_name",
      "messages": [
        "使用名为宁波招聘的词库，调查全国招聘风险"
      ],
      "expected": {
        "action": "omit",
        "reason": "资源名称不用于推断地域"
      }
    },
    {
      "id": "quoted_example",
      "messages": [
        "比如北京这种城市名可以出现在文案里，这只是举例，本次继续按原配置"
      ],
      "expected": {
        "action": "omit",
        "reason": "举例并非地域修改"
      }
    },
    {
      "id": "change_city",
      "existing_target": "克拉玛依市",
      "messages": [
        "改查深圳"
      ],
      "expected": {
        "action": "set",
        "target_text": "深圳",
        "selection_policy": "local_first_with_supplement"
      }
    },
    {
      "id": "clear",
      "existing_target": "克拉玛依市",
      "messages": [
        "取消地域限制，其他配置不变"
      ],
      "expected": {
        "action": "clear"
      }
    },
    {
      "id": "county_pending",
      "messages": [
        "只看北京市朝阳区"
      ],
      "expected": {
        "action": "set",
        "target_text": "北京市朝阳区",
        "selection_policy": "local_only",
        "result": "pending",
        "must_not_resolve_to": "北京市"
      }
    },
    {
      "id": "city_alias_ignores_county_collision",
      "existing_target": "克拉玛依市",
      "messages": [
        "改查朝阳"
      ],
      "expected": {
        "action": "set",
        "target_text": "朝阳",
        "selection_policy": "local_first_with_supplement",
        "result": "resolved",
        "target_name": "朝阳市",
        "must_not_ask_cross_level_clarification": true
      }
    },
    {
      "id": "multiple_pending",
      "messages": [
        "只看深圳和宁波"
      ],
      "expected": {
        "action": "set",
        "target_text": "深圳和宁波",
        "selection_policy": "local_only",
        "result": "pending",
        "must_not_choose_first": true
      }
    },
    {
      "id": "earlier_request",
      "messages": [
        "调查克拉玛依的欠薪内容",
        "请先展示拟用规则和词库",
        "采用刚才展示的规则和词库创建调查"
      ],
      "expected": {
        "action": "set",
        "target_text": "克拉玛依",
        "selection_policy": "local_first_with_supplement",
        "source_message_index": 0
      }
    },
    {
      "id": "province_city_alias_requires_clarification",
      "messages": [
        "调查吉林的消费投诉"
      ],
      "expected": {
        "action": "set",
        "target_text": "吉林",
        "selection_policy": "local_first_with_supplement",
        "result": "pending",
        "candidate_names": [
          "吉林省",
          "吉林市"
        ],
        "must_not_choose_first": true
      }
    },
    {
      "id": "unknown_city_name",
      "messages": [
        "调查深训的消费投诉"
      ],
      "expected": {
        "action": "set",
        "target_text": "深训",
        "selection_policy": "local_first_with_supplement",
        "result": "pending",
        "must_save_before_clarification": true,
        "must_not_resolve_to": "深圳市"
      }
    },
    {
      "id": "title_only_preserve",
      "existing_target": "克拉玛依市",
      "messages": [
        "标题改成招聘线索复核"
      ],
      "expected": {
        "action": "omit",
        "result": "preserve"
      }
    },
    {
      "id": "province_public_sentiment",
      "messages": [
        "调查新疆舆情"
      ],
      "expected": {
        "action": "set",
        "target_text": "新疆",
        "selection_policy": "local_first_with_supplement",
        "result": "resolved",
        "target_name": "新疆维吾尔自治区"
      }
    },
    {
      "id": "city_public_sentiment",
      "messages": [
        "调查深圳舆情"
      ],
      "expected": {
        "action": "set",
        "target_text": "深圳",
        "selection_policy": "local_first_with_supplement",
        "result": "resolved",
        "target_name": "深圳市"
      }
    },
    {
      "id": "place_named_fire",
      "messages": [
        "调查克拉玛依大火"
      ],
      "expected": {
        "action": "set",
        "target_text": "克拉玛依",
        "selection_policy": "local_first_with_supplement",
        "result": "resolved",
        "target_name": "克拉玛依市"
      }
    }
  ]
}
