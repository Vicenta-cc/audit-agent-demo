# Copy to .env.ethnic.local. Relative paths below resolve against the repository.
DEMO_DATA_DIR=./data/ethnic
DEMO_API_PORT=8168
DEMO_WEB_PORT=3168
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.7-plus
QWEN_REPORT_MODEL=qwen3.7-plus
QWEN_IMAGE_AUDIT_MODEL=qwen3.6-flash
QWEN_CONTACT_SHEET_MODEL=qwen3.6-flash
# Portable CPU ASR; downloads the model on first use. ffmpeg is provided by imageio-ffmpeg.
ASR_ENGINE=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
USE_REMOTE_ASR=false
REMOTE_ASR_BASE_URL=
REMOTE_INFERENCE_API_KEY=
# Finite ethnic discussion batch: 17 terms, up to 20 posts each; serial, no subcomments.
M3_POSTS_PER_KEYWORD=20
M3_ANALYZE_LIMIT=340
M3_COMMENTS_PER_POST=1000
CRAWLER_MAX_CONCURRENCY=1
CRAWLER_SLEEP_SECONDS=6
HERMES_CREATION_FAKE_RUNTIME=false
