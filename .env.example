DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_TEXT_MODEL=qwen3.7-plus
RESOURCE_GENERATION_API_KEY=
RESOURCE_GENERATION_BASE_URL=https://www.dmxapi.cn/v1
RESOURCE_GENERATION_MODEL=qwen3.7-plus
INVESTIGATION_MAX_POSTS=30
QWEN_VL_MODEL=qwen3.7-plus
QWEN_IMAGE_AUDIT_MODEL=qwen3.6-flash
QWEN_CONTACT_SHEET_MODEL=qwen3.6-flash
QWEN_USE_RESPONSE_FORMAT=false
QWEN_MAX_TOKENS=1024
FUSION_MAX_TOKENS=3000
FUSION_REQUEST_TIMEOUT=90
FUSION_TIMEOUT_RETRIES=1
FUSION_FRAME_EVIDENCE_MAX_CHARS=8000
FUSION_PROMPT_MAX_CHARS=24000
AUTO_ANALYZE_CRAWLED_CONTENT=true
ANALYSIS_MEDIA_SCOPE=all
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_SLEEP_SECONDS=6
MEDIACRAWLER_DIR=/absolute/path/to/MediaCrawler
# Optional: override the Python that has Playwright and Chromium installed.
CRAWLER_LOGIN_PYTHON=
CRAWLER_LOGIN_TIMEOUT_SECONDS=180
CRAWLER_LOGIN_HEADED=false
# Production should provide a persistent Fernet key. Local development uses data/crawler_auth.key.
CRAWLER_AUTH_ENCRYPTION_KEY=
OCR_VL_IMAGE_MAX_SIDE=1536
OCR_VL_IMAGE_QUALITY=90
OCR_VL_MAX_TOKENS=1500
FUSION_MAX_COMMENTS=50
VIDEO_REVIEW_MAX_FRAMES=32
VIDEO_OCR_MAX_FRAMES=16
VIDEO_REVIEW_SHEET_FRAMES=16
VIDEO_REVIEW_CONCURRENCY=2
VIDEO_REVIEW_ASR_OVERLAP_SECONDS=4
VIDEO_REVIEW_ASR_CHUNKS=4
COMMENT_AUDIT_BATCH_SIZE=20
COMMENT_AUDIT_CONCURRENCY=4
COMMENT_AUDIT_MAX_TOKENS=6000
COMMENT_FUSION_TOP_K=20
REQUEST_TIMEOUT=180

# Application users. Authentication is required by default.
APP_AUTH_MODE=required
# Defaults to XHS_AUDIT_DATA_DIR/investigation_creation.sqlite3.
APP_AUTH_DB=
APP_ACCOUNT_VALIDITY_DAYS=7
# Supported values: first_login, created_at.
APP_ACCOUNT_ACTIVATION_MODE=first_login
APP_AUTH_COOKIE_NAME=xhs_audit_session
# Production HTTPS must keep this true. Local HTTP tests may set false.
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_SAMESITE=lax
# Same-origin deployments may leave this empty. Otherwise list exact frontend origins.
# Wildcard origins are rejected while application authentication is required.
CORS_ALLOW_ORIGINS=

USE_REMOTE_VLM=false
USE_REMOTE_LLM=false

# Remote ASR. Keep false when running ASR locally.
USE_REMOTE_ASR=false
REMOTE_ASR_BASE_URL=
REMOTE_INFERENCE_API_KEY=
# Retry transient tunnel disconnects and remote 408/429/5xx responses.
REMOTE_ASR_REQUEST_RETRIES=3
REMOTE_ASR_RETRY_BACKOFF_SECONDS=2
ASR_ENGINE=dolphin
ASR_CHUNK_SECONDS=120
ASR_CHUNK_OVERLAP_SECONDS=5
ASR_LANGUAGE=ug
DOLPHIN_LANG_SYM=ug
DOLPHIN_REGION_SYM=CN
TASK_WORKER_PROCESSES=3
TASK_EXECUTION_CAPACITY=3
TASK_ANALYSIS_CAPACITY=3
DOLPHIN_WORD_TIMESTAMP=true

# Optional ASR translation after transcription.
TRANSLATION_ENABLED=true
ASR_TRANSLATE_ENGINE=qwen_text
ASR_TRANSLATE_MODEL=qwen3.7-plus
ASR_TRANSLATE_MAX_TOKENS=6000
ASR_TRANSLATE_ENABLE_THINKING=false
# Optional server-authorized ReportVersions available to Hermes Account drilldown.
# The Session anchor remains fixed and this list cannot be supplied by Tool arguments.
HERMES_AUTHORIZED_REPORT_VERSION_IDS=
# Product Investigation Turns from different Sessions may execute concurrently.
HERMES_INVESTIGATION_MAX_WORKERS=2
# Investigation streaming rollout switches. Keep disabled until each stage is accepted.
INVESTIGATION_ACTIVITY_STREAM_ENABLED=false
INVESTIGATION_ANSWER_STREAM_ENABLED=false
INVESTIGATION_CREATION_ANSWER_STREAM_ENABLED=false
INVESTIGATION_ACTIVITY_RECOVERY_TURN_LIMIT=20
INVESTIGATION_STREAM_REPLAY_BATCH_SIZE=256
